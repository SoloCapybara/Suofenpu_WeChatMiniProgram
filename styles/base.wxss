page {
  height: 100vh;
  background: #fff8ec;
  color: #161616;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 0%, rgba(255, 229, 180, 0.72), transparent 380rpx),
    linear-gradient(180deg, #fff7e8 0%, #fffaf2 42%, #f7f7f7 100%);
}

.content {
  height: 100vh;
  padding-bottom: 176rpx;
  box-sizing: border-box;
}

.screen {
  min-height: 100vh;
}

.home,
.menu-page,
.padded {
  padding: 28rpx 26rpx 40rpx;
  box-sizing: border-box;
}

