.panel {
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.empty {
  min-height: 420rpx;
  padding: 48rpx;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 14rpx;
  text-align: center;
}

.empty-title {
  color: #202124;
  font-size: 36rpx;
  font-weight: 900;
}

.empty-sub {
  color: #8d8d8d;
  font-size: 26rpx;
}

.cart-items {
  overflow: hidden;
}

.cart-item {
  min-height: 108rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
}

.cart-item:last-child {
  border-bottom: 0;
}

.cart-main {
  min-width: 0;
  display: grid;
  gap: 8rpx;
}

.cart-name,
.order-title {
  font-size: 30rpx;
  font-weight: 900;
}

.cart-meta,
.order-items,
.order-meta {
  color: #858585;
  font-size: 24rpx;
  line-height: 1.4;
}

.cart-remark {
  color: #b66a1f;
  font-size: 23rpx;
  line-height: 1.35;
}

.cart-page {
  position: relative;
  padding: 34rpx 36rpx 46rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 219, 164, 0.5), transparent 260rpx),
    linear-gradient(180deg, #fffaf1 0%, #fffdf8 48%, #f8f8f8 100%);
}

.cart-hero {
  position: relative;
  min-height: 150rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  overflow: hidden;
}

.cart-page-title,
.cart-page-sub {
  display: block;
}

.cart-page-title {
  color: #141414;
  font-size: 56rpx;
  line-height: 1.05;
  font-weight: 900;
}

.cart-page-sub {
  margin-top: 12rpx;
  color: #8a6a47;
  font-size: 30rpx;
  font-weight: 700;
}

.cart-product-card,
.cart-info-card,
.cart-summary-card {
  position: relative;
  z-index: 1;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 18rpx 48rpx rgba(115, 74, 31, 0.08);
}

.cart-product-card {
  margin-top: 18rpx;
  overflow: hidden;
}

.cart-product-card .cart-item {
  min-height: 166rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #f3e5d5;
  display: grid;
  grid-template-columns: 156rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 22rpx;
}

.cart-product-card .cart-item:last-child {
  border-bottom: 0;
}

.cart-dish-image {
  width: 156rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #fff1df;
}

.cart-product-card .cart-name {
  color: #141414;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 900;
}

.cart-product-card .cart-meta {
  margin-top: 10rpx;
  color: #858585;
  font-size: 24rpx;
  line-height: 1.35;
}

.cart-unit-price {
  display: block;
  margin-top: 18rpx;
  color: #4e4e4e;
  font-size: 28rpx;
  font-weight: 800;
}

.cart-product-card .cart-remark {
  margin-top: 8rpx;
}

.cart-qty {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cart-qty .qty-btn {
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  max-height: 56rpx;
  flex-basis: 56rpx;
  color: #1b1b1b;
  background: #f2f2f2;
  font-size: 32rpx;
  font-weight: 900;
}

.cart-qty .qty-btn.orange {
  color: #fff;
  background: linear-gradient(180deg, #ff971e, #ff5b05);
}

.cart-qty .qty-count {
  min-width: 34rpx;
  color: #111;
  font-size: 32rpx;
  font-weight: 900;
}

.cart-info-card {
  margin-top: 20rpx;
  overflow: hidden;
}

.cart-info-row {
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f1e3d3;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 16rpx;
}

.cart-info-row:last-child {
  border-bottom: 0;
}

.cart-info-row.address-row {
  min-height: 140rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.cart-row-left {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.cart-row-title {
  display: block;
  color: #181818;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
}

.cart-row-value {
  color: #6f6f6f;
  font-size: 27rpx;
  font-weight: 700;
}

.cart-row-value.active {
  color: #ff5b05;
}

.cart-row-arrow {
  color: #777;
  font-size: 46rpx;
  line-height: 1;
}

.cart-line-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  box-sizing: border-box;
  color: #ff8b2d;
}

.pin-icon {
  border: 4rpx solid #ffad55;
  border-radius: 50%;
}

.pin-icon::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffad55;
}

.pin-icon::after {
  content: "";
  position: absolute;
  left: 15rpx;
  bottom: -10rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 14rpx solid #ffad55;
}

.clock-icon {
  border: 4rpx solid #ffad55;
  border-radius: 50%;
}

.clock-icon::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 8rpx;
  width: 4rpx;
  height: 15rpx;
  background: #ffad55;
}

.clock-icon::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 21rpx;
  width: 13rpx;
  height: 4rpx;
  background: #ffad55;
}

.receipt-icon,
.coupon-line-icon {
  border: 4rpx solid #ffad55;
  border-radius: 8rpx;
}

.receipt-icon::before,
.coupon-line-icon::before {
  content: "";
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  top: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffad55;
}

.coupon-line-icon::after {
  content: "";
  position: absolute;
  left: -5rpx;
  right: -5rpx;
  top: 15rpx;
  height: 12rpx;
  background: #fff;
}

.cart-inline-input,
.cart-address-input {
  display: block;
  width: 100%;
  min-height: 34rpx;
  padding: 0;
  color: #777;
  font-size: 26rpx;
  line-height: 1.3;
}

.cart-inline-input {
  margin-top: 10rpx;
}

.cart-address-input {
  margin-top: 4rpx;
}

.cart-remark-block {
  padding: 24rpx;
}

.cart-remark-title {
  display: block;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 900;
}

.cart-remark-box {
  margin-top: 16rpx;
  min-height: 80rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 14rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: end;
  background: #fafafa;
}

.cart-remark-box textarea {
  width: 100%;
  height: 54rpx;
  min-height: 54rpx;
  color: #333;
  font-size: 26rpx;
  line-height: 1.35;
}

.cart-remark-box text {
  color: #8d8d8d;
  font-size: 24rpx;
}

.cart-summary-card {
  margin-top: 20rpx;
  padding: 26rpx 26rpx 28rpx;
}

.cart-summary-card .bill {
  margin-top: 0;
  padding: 0 0 16rpx;
  border-top: 0;
  border-bottom: 1rpx dashed #e7dfd6;
  gap: 16rpx;
}

.cart-summary-card .bill-line {
  color: #565656;
  font-size: 27rpx;
}

.cart-summary-card .bill-line.discount text:last-child {
  color: #ff5b05;
}

.cart-summary-card .total-line {
  padding-top: 20rpx;
  margin-top: 0;
  border-top: 0;
  color: #171717;
  font-size: 34rpx;
}

.cart-summary-card .total-line text:last-child {
  color: #ff5b05;
  font-size: 40rpx;
}

.cart-summary-card .pay-btn {
  min-height: 84rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff6a00, #ff5b05);
  box-shadow: 0 16rpx 28rpx rgba(255, 96, 5, 0.18);
}

.checkout {
  margin-top: 22rpx;
  padding: 24rpx;
}

.field {
  display: grid;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.field-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.field-label {
  color: #707070;
  font-size: 24rpx;
  font-weight: 800;
}

.field-action {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff760f;
  background: #fff2e6;
  font-size: 22rpx;
  font-weight: 800;
}

.field input,
.field textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eeeeee;
  border-radius: 16rpx;
  background: #fafafa;
  padding: 20rpx 22rpx;
  color: #202124;
  font-size: 28rpx;
}

.field textarea {
  min-height: 148rpx;
}

.option-section {
  display: grid;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  background: #f7f7f7;
  font-size: 25rpx;
  font-weight: 800;
}

.chip.active {
  color: #ff760f;
  background: #fff1e3;
  box-shadow: inset 0 0 0 2rpx #ff9b45;
}

.coupon-select-list {
  display: grid;
  gap: 12rpx;
}

.coupon-select {
  min-height: 82rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #333;
  background: #fafafa;
  text-align: left;
}

.coupon-select.active {
  color: #ff760f;
  background: #fff4e8;
  box-shadow: inset 0 0 0 2rpx #ff9b45;
}

.coupon-select.disabled {
  opacity: 0.45;
}

.coupon-select-title {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
}

.coupon-select-rule {
  display: block;
  margin-top: 6rpx;
  color: #999;
  font-size: 22rpx;
}

.coupon-select-price {
  flex: 0 0 auto;
  font-size: 30rpx;
  font-weight: 900;
}

.bill {
  margin-top: 8rpx;
  padding: 18rpx 0 4rpx;
  border-top: 1rpx solid #f0f0f0;
  display: grid;
  gap: 12rpx;
}

.bill-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #666;
  font-size: 25rpx;
}

.bill-line.discount {
  color: #ff760f;
}

.total-line {
  padding-top: 18rpx;
  margin-top: 4rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 900;
}

.pay-btn,
.primary-btn {
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(180deg, #ff9834, #ff6f0b);
  font-size: 30rpx;
  font-weight: 900;
}

.pay-btn {
  width: 100%;
  margin-top: 24rpx;
}

