.cart-bar {
  position: fixed;
  left: 26rpx;
  right: 26rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 8;
  min-height: 104rpx;
  padding: 14rpx 14rpx 14rpx 18rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #181818;
  border: 1rpx solid rgba(255, 132, 27, 0.14);
  box-shadow: 0 16rpx 40rpx rgba(28, 20, 12, 0.1);
}

.cart-bar-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cart-bar-icon {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  box-sizing: border-box;
  border: 5rpx solid #ff7a12;
  border-top: 0;
  border-radius: 8rpx 8rpx 14rpx 14rpx;
}

.cart-bar-icon::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: -16rpx;
  width: 26rpx;
  height: 18rpx;
  border: 5rpx solid #ff7a12;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.cart-bar-badge {
  position: absolute;
  right: -16rpx;
  top: -24rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #ef3d32;
  font-size: 20rpx;
  font-weight: 700;
}

.cart-total {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.cart-count {
  display: block;
  margin-top: 6rpx;
  color: #8a7564;
  font-size: 24rpx;
}

.cart-bar .primary-btn {
  min-width: 176rpx;
  min-height: 72rpx;
  padding: 0 34rpx;
}

