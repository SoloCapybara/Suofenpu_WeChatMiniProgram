.hero-swiper {
  height: 300rpx;
  overflow: hidden;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.hero-swiper swiper-item {
  overflow: hidden;
  border-radius: 22rpx;
}

.hero-card {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #f7dfb7;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 300rpx;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255, 236, 199, 0.96) 0%, rgba(255, 236, 199, 0.86) 42%, rgba(255, 236, 199, 0.08) 100%),
    radial-gradient(circle at 10% 0%, rgba(255, 255, 255, 0.56), transparent 260rpx);
}

.hero-text {
  position: absolute;
  left: 44rpx;
  top: 48rpx;
  display: grid;
  gap: 14rpx;
}

.hero-title {
  color: #2a0900;
  font-size: 58rpx;
  line-height: 1.05;
  font-weight: 700;
}

.hero-title.red {
  color: #c21e13;
}

.hero-badge {
  width: 360rpx;
  margin-top: 10rpx;
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(239, 139, 81, 0.5);
  border-radius: var(--radius-pill);
  color: #d94b17;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 600;
}

.service-card,
.notice-card,
.recommend-card {
  margin-top: 22rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.service-card {
  padding: 28rpx 18rpx 26rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6rpx;
}

.service-item {
  min-width: 0;
  display: grid;
  justify-items: center;
  gap: 8rpx;
  text-align: center;
}

.service-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(180deg, #ff9b45, #ff6e0b);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(255, 110, 11, 0.22);
}

.service-title {
  color: #151515;
  font-size: 27rpx;
  line-height: 1.15;
  font-weight: 700;
}

.service-sub {
  color: #8d8d8d;
  font-size: 22rpx;
  line-height: 1.15;
}

.notice-card {
  min-height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.notice-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(180deg, #ffb35a, #ff760f);
  font-size: 20rpx;
  font-weight: 700;
}

.notice-text {
  flex: 1;
  color: #3b332b;
  font-size: 26rpx;
  font-weight: 500;
}

.notice-arrow,
.module-more {
  color: var(--color-muted);
  font-size: 28rpx;
}

.recommend-card {
  padding: 26rpx 20rpx 24rpx;
}

.module-head {
  padding: 0 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.module-title {
  font-size: var(--font-title);
  font-weight: var(--font-weight-title);
}

.module-more {
  font-size: 26rpx;
}

.recommend-scroll {
  width: 100%;
  white-space: nowrap;
}

.recommend-track {
  display: flex;
  gap: 18rpx;
}

.product-card {
  flex: 0 0 184rpx;
  width: 184rpx;
  overflow: hidden;
  border-radius: 16rpx;
  display: inline-flex;
  flex-direction: column;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.product-image {
  width: 184rpx;
  height: 154rpx;
}

.product-info {
  padding: 14rpx 12rpx 16rpx;
  display: grid;
  gap: 8rpx;
}

.product-name {
  color: #111;
  font-size: 25rpx;
  line-height: 1.15;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  color: #858585;
  font-size: 21rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-foot,
.dish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.product-price,
.price {
  color: var(--color-price);
  font-size: 34rpx;
  line-height: 1;
  font-weight: 700;
}

.product-foot .round-add {
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  flex-basis: 48rpx;
  border-radius: 14rpx;
}

.product-foot .round-add::after {
  border-radius: 18rpx;
}

.product-foot .plus-icon {
  width: 18rpx;
  height: 18rpx;
}

.product-foot .plus-icon::before {
  width: 18rpx;
}

.product-foot .plus-icon::after {
  height: 18rpx;
}

.member-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx 24rpx;
  border-radius: 24rpx;
  color: #f8d59d;
  background:
    radial-gradient(circle at 80% 0%, rgba(255, 255, 255, 0.12), transparent 180rpx),
    linear-gradient(135deg, #252525, #111);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.16);
}

.member-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.member-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 700;
}

.member-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #ffd892;
}

.member-btn {
  min-width: 168rpx;
  height: 64rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2b1a08;
  background: linear-gradient(180deg, #ffe1a6, #e9b159);
  font-size: 26rpx;
  font-weight: 700;
}

.member-rights {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 224, 168, 0.28);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}

.member-rights text {
  color: #f5cf8e;
  text-align: center;
  font-size: 22rpx;
}

