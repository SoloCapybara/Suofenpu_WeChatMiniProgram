.menu-page {
  height: 100%;
  min-height: 0;
  padding: 26rpx 20rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.menu-page.with-cart-bar {
  padding-bottom: calc(132rpx + 28rpx);
}

.menu-search {
  height: 88rpx;
  flex: 0 0 auto;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.menu-search image {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
}

.menu-search input {
  min-width: 0;
  flex: 1;
  color: #222;
  font-size: 30rpx;
  line-height: 1.2;
}

.menu-search-placeholder {
  color: #969696;
}

.menu-shell {
  margin-top: 28rpx;
  flex: 1 1 auto;
  min-height: 0;
  height: auto;
  max-height: none;
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  gap: 16rpx;
  overflow: hidden;
}

.menu-category-list {
  height: 100%;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
  align-self: stretch;
  padding-bottom: 12rpx;
}

.menu-section-list {
  height: 100%;
  min-width: 0;
  overflow: hidden;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

.menu-category {
  position: relative;
  min-height: 106rpx;
  padding: 0 12rpx 0 16rpx;
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr);
  align-items: center;
  gap: 10rpx;
  color: #202020;
  font-size: 24rpx;
  font-weight: 600;
  transition: background 0.18s ease, color 0.18s ease;
}

.menu-category::before {
  content: "";
  position: absolute;
  left: 0;
  top: 25rpx;
  width: 8rpx;
  height: 56rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: transparent;
}

.menu-category image {
  width: 34rpx;
  height: 34rpx;
}

.menu-category text {
  min-width: 0;
  line-height: 1.25;
  word-break: break-all;
}

.menu-category.active {
  color: var(--color-primary);
  background: linear-gradient(90deg, rgba(255, 243, 232, 0.95), rgba(255, 246, 235, 0.35));
}

.menu-category.active::before {
  background: var(--color-primary);
}

.menu-category.active image {
  filter: brightness(0) saturate(100%) invert(51%) sepia(91%) saturate(2834%) hue-rotate(354deg) brightness(100%) contrast(103%);
}

.menu-section {
  margin-bottom: 24rpx;
  padding: 22rpx 20rpx 26rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.menu-section-head {
  height: 50rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-section-title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #191919;
  font-size: 31rpx;
  font-weight: 700;
}

.menu-section-title image {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) saturate(100%) invert(51%) sepia(91%) saturate(2834%) hue-rotate(354deg) brightness(100%) contrast(103%);
}

.menu-more {
  color: #7d7d7d;
  font-size: 24rpx;
}

.menu-product-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.menu-product-card {
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 12rpx 4rpx;
  border-radius: 16rpx;
  background: transparent;
  box-shadow: none;
}

.menu-product-card + .menu-product-card {
  border-top: 1rpx solid var(--color-line, #eeebe6);
  padding-top: 20rpx;
  margin-top: 4rpx;
}

.menu-product-image-wrap {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f6eadc;
  flex: 0 0 168rpx;
}

.menu-product-image {
  width: 168rpx;
  height: 168rpx;
}

.menu-product-badge {
  position: absolute;
  left: 0;
  top: 0;
  min-width: 60rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 0 0 12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(180deg, #ff4d4d, #ff7524);
  font-size: 20rpx;
  font-weight: 600;
}

.menu-product-body {
  min-width: 0;
  padding: 4rpx 0 0;
  display: flex;
  flex-direction: column;
}

.menu-product-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #181818;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 700;
}

.menu-product-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #888;
  font-size: 24rpx;
  line-height: 1.35;
  height: auto;
  max-height: 64rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.menu-product-foot {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.menu-product-price {
  min-width: 0;
  color: var(--color-price, #ff5d0b);
  font-size: 32rpx;
  font-weight: 700;
}

.menu-product-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-product-actions .qty-btn {
  width: 50rpx;
  min-width: 50rpx;
  height: 50rpx;
  min-height: 50rpx;
  font-size: 25rpx;
}

.menu-product-actions .round-add {
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  border-radius: 16rpx;
}

.menu-product-actions .plus-icon {
  width: 20rpx;
  height: 20rpx;
}

.menu-product-actions .plus-icon::before {
  width: 20rpx;
}

.menu-product-actions .plus-icon::after {
  height: 20rpx;
}

.menu-product-actions .qty-count {
  min-width: 20rpx;
  font-size: 24rpx;
}

.menu-search-empty {
  height: 260rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b8b8b;
  background: rgba(255, 255, 255, 0.86);
  font-size: 28rpx;
}
