.mine-page {
  position: relative;
  padding: 22rpx 34rpx 34rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 12%, rgba(255, 213, 151, 0.36), transparent 210rpx),
    radial-gradient(circle at 0% 32%, rgba(255, 235, 197, 0.7), transparent 230rpx),
    linear-gradient(180deg, #ffffff 0%, #fffaf2 42%, #fffdf8 100%);
}

.mine-page::before,
.mine-page::after {
  content: "";
  position: absolute;
  z-index: 0;
  border-radius: 999rpx;
  background: rgba(255, 218, 165, 0.34);
}

.mine-page::before {
  width: 280rpx;
  height: 90rpx;
  right: -110rpx;
  top: 104rpx;
  transform: rotate(-28deg);
}

.mine-page::after {
  width: 260rpx;
  height: 82rpx;
  left: -140rpx;
  top: 272rpx;
  transform: rotate(-18deg);
}

.mine-guest-hero,
.mine-benefit-card,
.mine-welcome-card,
.mine-login-card {
  position: relative;
  z-index: 1;
  border: 2rpx solid rgba(255, 157, 51, 0.16);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 46rpx rgba(105, 69, 31, 0.07);
}

.mine-guest-hero {
  min-height: 250rpx;
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at 5% 0%, rgba(255, 196, 126, 0.42), transparent 112rpx),
    radial-gradient(circle at 94% 86%, rgba(255, 221, 171, 0.36), transparent 122rpx),
    linear-gradient(105deg, #fff1dd 0%, #ffffff 52%, #fff7eb 100%);
}

.mine-guest-hero::after {
  content: "";
  position: absolute;
  right: 22rpx;
  bottom: 28rpx;
  width: 160rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 18rpx solid rgba(255, 174, 85, 0.08);
  transform: rotate(-16deg);
}

.mine-guest-girl {
  position: relative;
  z-index: 1;
  align-self: flex-end;
  width: 286rpx;
  height: 260rpx;
  margin-left: -58rpx;
  margin-bottom: -10rpx;
  flex: 0 0 274rpx;
}

.mine-guest-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  display: grid;
  gap: 22rpx;
}

.mine-guest-title {
  color: #202124;
  font-size: 58rpx;
  line-height: 1;
  font-weight: 900;
}

.mine-guest-sub {
  color: #7c431c;
  font-size: 30rpx;
  line-height: 1.3;
}

.mine-benefit-card {
  margin-top: 22rpx;
  padding: 30rpx 28rpx 28rpx;
}

.mine-section-title {
  display: block;
  margin-bottom: 26rpx;
  color: #1d1d1d;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
}

.mine-benefit-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.mine-benefit-item {
  min-width: 0;
  display: grid;
  justify-items: center;
  gap: 10rpx;
  text-align: center;
}

.mine-benefit-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #fff4e8, #ffe8cd);
  box-shadow: inset 0 0 0 1rpx rgba(255, 142, 37, 0.12);
}

.mine-benefit-icon image {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) saturate(100%) invert(55%) sepia(94%) saturate(2065%) hue-rotate(352deg) brightness(101%) contrast(101%);
}

.mine-benefit-name {
  color: #191919;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 800;
}

.mine-benefit-desc {
  color: #838383;
  font-size: 22rpx;
  line-height: 1.25;
}

.mine-welcome-card {
  min-height: 178rpx;
  margin-top: 24rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: #fff0d8;
}

.mine-welcome-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.mine-welcome-copy {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 10rpx;
}

.mine-welcome-title {
  color: #6f3513;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 900;
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.45);
}

.mine-welcome-sub {
  color: #7d4926;
  font-size: 28rpx;
  line-height: 1.25;
  text-shadow: 0 2rpx 10rpx rgba(255, 255, 255, 0.45);
}

.mine-login-card {
  margin-top: 24rpx;
  padding: 30rpx 38rpx 24rpx;
  display: grid;
  gap: 22rpx;
}

.mine-login-title {
  color: #202124;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  text-align: center;
}

.mine-phone-btn,
.mine-wechat-btn {
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.mine-phone-btn::after,
.mine-wechat-btn::after {
  border: 0;
}

.mine-phone-btn:active,
.mine-wechat-btn:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.mine-phone-btn {
  color: #ff6811;
  background: #fff;
  border: 2rpx solid #ff7a12;
}

.mine-wechat-btn {
  color: #fff;
  background: linear-gradient(90deg, #39bf38, #25aa2f);
  box-shadow: 0 14rpx 28rpx rgba(37, 170, 47, 0.18);
}

.mine-phone-btn image,
.mine-wechat-btn image {
  width: 42rpx;
  height: 42rpx;
}

.mine-phone-btn image {
  filter: brightness(0) saturate(100%) invert(55%) sepia(94%) saturate(2065%) hue-rotate(352deg) brightness(101%) contrast(101%);
}

.mine-wechat-btn image {
  filter: brightness(0) invert(1);
}

.mine-login-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  color: #8a8a8a;
  font-size: 24rpx;
  line-height: 1.4;
}

.mine-login-agreement .small-check {
  width: 28rpx;
  height: 28rpx;
  font-size: 19rpx;
}

.mine-login-agreement .link {
  color: #ff6811;
  font-weight: 800;
}

.mine-profile-card {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  min-height: 156rpx;
  padding: 24rpx 30rpx;
  border: 2rpx solid rgba(255, 157, 51, 0.25);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 30rpx;
  background:
    linear-gradient(90deg, rgba(255, 245, 229, 0.98), rgba(255, 255, 255, 0.88));
  box-shadow: 0 18rpx 46rpx rgba(255, 139, 28, 0.12);
}

.mine-avatar {
  position: relative;
  z-index: 1;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 255, 255, 0.96);
  background: #fff2df;
  box-shadow: 0 14rpx 32rpx rgba(255, 113, 18, 0.22);
}

.mine-user-main {
  position: relative;
  z-index: 1;
  min-width: 0;
  display: grid;
  gap: 16rpx;
}

.mine-user-name {
  color: #191919;
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 900;
}

.mine-user-phone {
  width: max-content;
  max-width: 360rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  color: #b96a19;
  background: rgba(255, 224, 181, 0.72);
  font-size: 25rpx;
  line-height: 1.2;
}

.mine-stat-grid {
  position: relative;
  z-index: 1;
  margin: 24rpx 0 22rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.mine-stat-card {
  min-height: 176rpx;
  border: 2rpx solid rgba(255, 157, 51, 0.18);
  border-radius: 24rpx;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 42rpx rgba(105, 69, 31, 0.07);
}

.mine-stat-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(180deg, #ff9f3c, #ff6811);
  box-shadow: 0 14rpx 30rpx rgba(255, 113, 18, 0.18);
}

.ticket-icon {
  border-radius: 10rpx;
}

.ticket-icon::before,
.ticket-icon::after {
  content: "";
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #fff;
}

.ticket-icon::before {
  margin-left: -7rpx;
}

.ticket-icon::after {
  margin-right: -7rpx;
}

.point-icon {
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.order-icon {
  position: relative;
  border-radius: 10rpx;
}

.order-icon::before,
.order-icon::after {
  content: "";
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #fff;
}

.order-icon::before {
  top: 18rpx;
}

.order-icon::after {
  top: 32rpx;
}

.mine-stat-num {
  color: #ff6811;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 900;
}

.mine-stat-label {
  color: #6f6f6f;
  font-size: 28rpx;
  line-height: 1.2;
}

.mine-menu-card {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 14rpx;
  border: 2rpx solid rgba(255, 157, 51, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 18rpx 42rpx rgba(105, 69, 31, 0.06);
  padding: 14rpx;
}

.mine-list-row {
  min-height: 116rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(105, 69, 31, 0.04);
  transition: transform 0.14s ease, background-color 0.14s ease, box-shadow 0.14s ease;
}

.mine-list-row:active,
.hover-touch:active {
  background: #fff5e8;
  transform: scale(0.985);
  box-shadow: 0 4rpx 14rpx rgba(255, 118, 15, 0.12);
}

.mine-row-left,
.mine-row-right {
  display: flex;
  align-items: center;
}

.mine-row-left {
  min-width: 0;
  gap: 22rpx;
  color: #202020;
  font-size: 31rpx;
  font-weight: 900;
}

.mine-row-right {
  gap: 16rpx;
  color: #7a7a7a;
  font-size: 30rpx;
  font-weight: 700;
}

.mine-arrow {
  color: #7d7d7d;
  font-size: 48rpx;
  line-height: 1;
}

.mine-row-icon {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
}

.danger-row .mine-row-left,
.danger-row .mine-arrow {
  color: #ef3d32;
}

