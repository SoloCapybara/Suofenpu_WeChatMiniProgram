.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  height: calc(124rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eeeeee;
  box-shadow: 0 -8rpx 26rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1 1 0;
  min-width: 0;
  height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8b8b8b;
  background: transparent;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
}

.tab.active {
  color: #ff760f;
}

.tab-icon,
.tab-icon-wrap {
  width: 42rpx;
  height: 42rpx;
}

.tab-icon-wrap {
  position: relative;
}

.tab-icon {
  display: block;
}

.cart-badge {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #ef3d32;
  font-size: 20rpx;
  font-weight: 900;
}
