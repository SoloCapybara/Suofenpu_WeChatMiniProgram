.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  height: calc(124rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -6rpx 24rpx rgba(28, 20, 12, 0.05);
}

.tab-indicator {
  position: absolute;
  left: 0;
  top: 16rpx;
  z-index: 0;
  width: 20%;
  height: 92rpx;
  pointer-events: none;
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.tab-indicator::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  width: 78%;
  height: 100%;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 154, 58, 0.18), rgba(255, 118, 15, 0.1));
  box-shadow: inset 0 0 0 1rpx rgba(255, 118, 15, 0.12);
  transform: translateX(-50%);
}

.tabbar[data-active="home"] .tab-indicator {
  transform: translateX(0%);
}

.tabbar[data-active="menu"] .tab-indicator {
  transform: translateX(100%);
}

.tabbar[data-active="orders"] .tab-indicator {
  transform: translateX(200%);
}

.tabbar[data-active="cart"] .tab-indicator {
  transform: translateX(300%);
}

.tabbar[data-active="mine"] .tab-indicator {
  transform: translateX(400%);
}

.tab {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  min-width: 0;
  height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8a8680;
  background: transparent;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.1;
  transition: color 0.22s ease;
}

.tab.active {
  color: #ff6f0b;
}

.tab-icon-stack,
.tab-icon-wrap {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.tab-icon-stack {
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.tab.active .tab-icon-stack {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  display: block;
  transition: opacity 0.22s ease;
}

.tab-icon-idle {
  opacity: 1;
}

.tab-icon-active {
  opacity: 0;
}

.tab.active .tab-icon-idle {
  opacity: 0;
}

.tab.active .tab-icon-active {
  opacity: 1;
}

.cart-badge {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  z-index: 2;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #ef3d32;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}
